# Shopify Dev Dashboard custom-app configuration.
# Copy this file to .env and replace every placeholder locally.
# Never commit the .env file or share its contents.

SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=replace_with_the_client_id_from_the_dev_dashboard
SHOPIFY_CLIENT_SECRET=replace_with_the_client_secret_from_the_dev_dashboard
SHOPIFY_API_VERSION=2026-07

# Optional: only for a legacy admin-created custom app that already has a token.
# New Dev Dashboard apps should use CLIENT_ID and CLIENT_SECRET instead.
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_replace_with_legacy_token

# Set to true only if you want structured JSON logs in addition to the CSV report.
SWATCH_LINKER_JSON_LOGS=false
